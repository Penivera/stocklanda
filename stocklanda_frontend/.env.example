# Solana RPC endpoint used by the app and the wallet adapter.
# For a devnet deployment use the public devnet RPC (or your own).
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Pyth Hermes API key. Optional: without it, public-equity prices fall back to
# indicative values and only feed discovery works.
# NEXT_PUBLIC_PYTH_API_KEY=

# Path to the deployer/admin keypair used by the server API routes
# (faucet, settle, flagship). Defaults to ~/.config/solana/id.json.
# KEYPAIR_PATH=/home/you/.config/solana/id.json
