            "docs": [
              "Mint of the underlying tokenised stock."
            ],
            "type": "pubkey"
          },
          {
            "name": "amount_per_unit",
            "docs": [
              "Base units of this mint required per one basket unit."
            ],
            "type": "u64"
          },
          {
            "name": "weight_bps",
            "docs": [
              "Display weight in basis points (informational, sums to 10000)."
            ],
            "type": "u16"
          }
        ]
      }
    },
