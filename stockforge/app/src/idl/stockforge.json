            "docs": [
              "Asset locked as collateral (quote mint for puts, underlying for calls)."
            ],
            "type": "pubkey"
          },
          {
            "name": "premium_mint",
            "docs": [
              "Mint used to pay the premium (the protocol quote mint)."
