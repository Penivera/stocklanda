  "types": [
    {
      "name": "Basket",
      "docs": [
        "A user-defined, fully asset-backed index fund (custom ETF)."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "creator",
            "type": "pubkey"
          },
          {
            "name": "nonce",
            "docs": [
              "Monotonic per-creator id used in the PDA seeds."
            ],
            "type": "u64"
          },
          {
            "name": "share_mint",
            "docs": [
              "SPL mint representing proportional ownership of the vault."
            ],
            "type": "pubkey"
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "components",
            "type": {
              "vec": {
                "defined": {
                  "name": "BasketComponent"
                }
              }
            }
          },
          {
            "name": "total_units",
            "docs": [
              "Total basket units ever minted (informational)."
            ],
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "mint_bump",
            "docs": [
              "Bump for the share mint PDA."
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "BasketComponent",
      "docs": [
